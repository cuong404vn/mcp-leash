{
  "mcpServers": {
    "filesystem": {
      "command": "uvx",
      "args": [
        "mcp-leash",
        "run",
        "--policy",
        "/ABSOLUTE/PATH/TO/mcp-leash.yaml",
        "--project-dir",
        "/ABSOLUTE/PATH/TO/project",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/ABSOLUTE/PATH/TO/project"
      ]
    }
  }
}
